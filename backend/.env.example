PORT=4000
# Local MySQL (Workbench / localhost:3306)
DATABASE_URL=mysql://root:YOUR_PASSWORD@127.0.0.1:3306/house_of_bread
# GoDaddy PaaS injects these — app builds DATABASE_URL automatically when DB_HOST is set:
# DB_HOST=
# DB_PORT=3306
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=replace-me-with-a-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@houseofbread.local
ADMIN_BOOTSTRAP_PASSWORD=change-me-now
SESSION_TTL_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email: auto | smtp | godaddy  (auto = godaddy when NODE_ENV=production or DB_HOST set)
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@houseofbreadlondon.co.uk
# Quote if the password contains # (dotenv treats unquoted # as a comment)
SMTP_PASS="your-smtp-password"
MAIL_FROM=House of Bread <info@houseofbreadlondon.co.uk>
FRONTEND_URL=http://localhost:3000
