# ---------------------------------------------------------------------------
# House of Bread backend - environment variables
# Copy to backend/.env for local development. In production, set these in the
# hosting dashboard; never commit real values.
# ---------------------------------------------------------------------------

# Runtime --------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# The hosting platform assigns PORT. Only set it locally.
PORT=4000
# Interface to bind. Leave as 0.0.0.0 on hosting platforms.
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent  (default: info in production, debug otherwise)
LOG_LEVEL=info
# Number of proxies in front of the app, or true/false. Default: 1 in production, false otherwise.
TRUST_PROXY=1

# Database (MySQL) -----------------------------------------------------------
# Percent-encode special characters in the password (@ -> %40, # -> %23).
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# Keep the pool small on shared hosting (default 3). Pool/connect timeouts in seconds.
DB_POOL_SIZE=3
DB_POOL_TIMEOUT_SECONDS=10
DB_CONNECT_TIMEOUT_SECONDS=10

# Auth -----------------------------------------------------------------------
# At least 32 random characters in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
# Google Sign-In (optional). Only the client ID is needed server-side.
GOOGLE_CLIENT_ID=

# Browser access -------------------------------------------------------------
# Comma-separated allowlist of frontend origins (no trailing slash). Required in production.
CORS_ORIGINS=http://localhost:3000
# Used to build links in emails. Defaults to the first CORS origin.
FRONTEND_URL=http://localhost:3000
# Session cookie flags. Secure defaults to true in production.
# Use COOKIE_SAME_SITE=none (with COOKIE_SECURE=true) only if the frontend is on a different site than the API.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email (SMTP) ---------------------------------------------------------------
# smtp | none  (none disables outgoing email; signup verification emails will not be sent)
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true for implicit TLS on port 465, false for STARTTLS on 587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=replace-me
MAIL_FROM=House of Bread <you@yourdomain.com>

# Protection & caching (optional) --------------------------------------------
# Per-IP request limits per window (defaults: 300 general, 20 for auth/email endpoints, 15 min window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
# Cache-Control max-age (seconds) for anonymous storefront GETs. 0 disables.
PUBLIC_CACHE_MAX_AGE=60
# Expose Swagger UI at /docs. Default: enabled outside production, disabled in production.
ENABLE_DOCS=false
