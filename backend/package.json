{
  "name": "house-of-bread-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:apply": "npm run db:generate && npm run migrate"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "8.20.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
